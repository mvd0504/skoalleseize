<!doctype html>
<html lang="nl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="MFC de Skoalleseize in Easterein: dé ontmoetingsplek voor jong en oud, waar sport, cultuur, welzijn en zorg samenkomen.">
<title>MFC de Skoalleseize</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Atkinson+Hyperlegible:ital,wght@0,400;0,700;1,400&display=swap">
<style>
/* Layout: dorpsprofiel als horizon — logo-header, open hero, aanbod in een raster van zes "ruimtes", verenigingen als lijst, gegevens als register */
:root{
  --bg:#f6f7f8; --surface:#ffffff; --ink:#14212e; --muted:#566373;
  --line:#d9dee4; --blue:#1d4f91; --red:#c8202f; --tint:#e7eef7;
  --logo-filter:none;
  --display:"Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  --body:"Atkinson Hyperlegible", "Segoe UI", system-ui, sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0f161e; --surface:#16202b; --ink:#e8edf2; --muted:#9eabb9;
  --line:#2a3644; --blue:#7fa9e6; --red:#ef5d68; --tint:#1a2a3d;
  --logo-filter:invert(1); color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0f161e; --surface:#16202b; --ink:#e8edf2; --muted:#9eabb9;
  --line:#2a3644; --blue:#7fa9e6; --red:#ef5d68; --tint:#1a2a3d;
  --logo-filter:invert(1); color-scheme:dark}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:1.0625rem;line-height:1.6}
.wrap{max-width:1080px;margin:0 auto;padding-inline:clamp(16px,4vw,40px)}
a{color:var(--blue)}
a:focus-visible,button:focus-visible{outline:3px solid var(--blue);outline-offset:3px;border-radius:4px}
h1,h2,h3{font-family:var(--display);line-height:1.1;text-wrap:balance;margin:0}
.eyebrow{font-family:var(--display);font-weight:700;font-size:.8rem;letter-spacing:.12em;text-transform:uppercase;color:var(--red);margin:0 0 .75rem}

/* header */
header.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
header.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-block:10px}
.brand img{height:42px;width:auto;display:block;filter:var(--logo-filter)}
nav{display:flex;gap:clamp(10px,2.5vw,26px);flex-wrap:wrap}
nav a{font-family:var(--display);font-weight:500;font-size:.95rem;color:var(--ink);text-decoration:none}
nav a:hover{color:var(--blue)}
@media (max-width:620px){nav{display:none}}

/* hero */
.hero{padding-block:clamp(48px,9vw,104px) clamp(40px,6vw,72px)}
.hero-logo{width:min(560px,100%);height:auto;display:block;filter:var(--logo-filter);margin-bottom:clamp(28px,5vw,48px)}
.hero h1{font-size:clamp(2.3rem,6.2vw,4.4rem);font-weight:800;letter-spacing:-.02em;max-width:16ch}
.hero h1 span{color:var(--blue)}
.hero p.lead{font-size:clamp(1.1rem,2vw,1.3rem);color:var(--muted);max-width:58ch;margin:1.25rem 0 0}
.hero .meta{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:2rem;font-size:.95rem;color:var(--muted)}
.hero .meta b{color:var(--ink)}
.flag{display:flex;height:6px;max-width:220px;margin-top:2.25rem;border-radius:3px;overflow:hidden}
.flag i{flex:1;background:var(--blue)}.flag i:nth-child(2){background:var(--surface);border-block:1px solid var(--line)}.flag i:nth-child(3){background:var(--blue)}

section{padding-block:clamp(48px,8vw,88px);border-top:1px solid var(--line)}
section h2{font-size:clamp(1.8rem,4vw,2.6rem);font-weight:700;letter-spacing:-.01em;max-width:22ch}
.intro{color:var(--muted);max-width:62ch;margin:1rem 0 0}

/* aanbod */
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:1px;background:var(--line);border:1px solid var(--line);border-radius:14px;overflow:hidden;margin-top:2.5rem}
.item{background:var(--surface);padding:28px 26px 30px;display:flex;flex-direction:column;gap:.6rem;min-width:0}
.item svg{width:34px;height:34px;stroke:var(--blue);fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.item h3{font-size:1.3rem;font-weight:700}
.item p{margin:0;color:var(--muted)}
.closing{margin-top:2.5rem;padding:24px 28px;background:var(--tint);border-radius:14px;font-size:1.15rem;max-width:none}
.closing strong{color:var(--blue)}

/* verenigingen */
.clubs{list-style:none;padding:0;margin:2.25rem 0 0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:16px}
.clubs li{border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:20px 22px;display:flex;flex-direction:column;gap:.25rem;min-width:0}
.clubs .tag{font-family:var(--display);font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--red)}
.clubs .name{font-family:var(--display);font-weight:700;font-size:1.25rem}
.clubs a{font-size:.95rem;overflow-wrap:anywhere}
.clubs .none{font-size:.95rem;color:var(--muted)}

/* gegevens */
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:clamp(24px,5vw,56px);margin-top:2.25rem}
dl{margin:0;display:grid;grid-template-columns:minmax(0,9.5rem) minmax(0,1fr);border-top:1px solid var(--line)}
dt,dd{margin:0;padding:12px 0;border-bottom:1px solid var(--line)}
dt{color:var(--muted);font-size:.92rem;padding-right:12px}
dd{font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.contact{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:26px}
.contact h3{font-size:1.35rem;margin-bottom:1rem}
.row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 0;border-bottom:1px solid var(--line);flex-wrap:wrap}
.row:last-child{border-bottom:0}
.row .k{color:var(--muted);font-size:.9rem;display:block}
.row .v{font-weight:700;user-select:all;overflow-wrap:anywhere}
.row > div{min-width:0}
button.copy{font:inherit;font-size:.85rem;border:1px solid var(--line);background:var(--bg);color:var(--ink);border-radius:999px;padding:5px 14px;cursor:pointer}
button.copy:hover{border-color:var(--blue);color:var(--blue)}

footer{border-top:1px solid var(--line);padding-block:28px;color:var(--muted);font-size:.9rem}
footer .wrap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
body{margin:0}
</style>
</head>
<body>


<header class="top">
  <div class="wrap">
    <a class="brand" href="#top" aria-label="De Skoalleseize, naar boven"><img src="data:image/png;base64," alt="Logo De Skoalleseize"></a>
    <nav aria-label="Hoofdmenu">
      <a href="#aanbod">Aanbod</a>
      <a href="#verenigingen">Verenigingen</a>
      <a href="#gegevens">Contact</a>
      <a href="https://www.facebook.com/Skoalleseize/?locale=nl_NL" target="_blank" rel="noopener">Facebook</a>
    </nav>
  </div>
</header>

<main id="top">
  <div class="hero wrap">
    <img class="hero-logo" src="data:image/png;base64," alt="">
    <p class="eyebrow">Multifunctioneel Centrum · Easterein</p>
    <h1>Het kloppende hart van <span>het dorp</span></h1>
    <p class="lead">MFC de Skoalleseize is dé ontmoetingsplek voor jong en oud, waar sport, cultuur, welzijn en zorg samenkomen. Het centrum biedt een stevig thuis voor verenigingen en breidt uit met nieuwe activiteiten om iedereen te verbinden.</p>
    <div class="meta"><span><b>Adres</b> 't Heechhiem 11, Easterein</span><span><b>Telefoon</b> 0515 333 027</span></div>
    <div class="flag" aria-hidden="true"><i></i><i></i><i></i></div>
  </div>

  <section id="aanbod">
    <div class="wrap">
      <p class="eyebrow">Doelstelling</p>
      <h2>Voor iedereen een plek om te ontmoeten</h2>
      <p class="intro">Naast de vaste verenigingen groeit het aanbod in zes richtingen.</p>

      <div class="grid">
        <article class="item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="13" cy="4" r="2"/><path d="M4 21l4-7 3 2 2-5 4 3h3"/><path d="M8 14l1-5 4-1"/></svg>
          <h3>Sport &amp; Beweging</h3>
          <p>Versterking van sportclubs met lessen zoals yoga, pilates en seniorenfit.</p>
        </article>
        <article class="item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18V5l11-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="17" cy="16" r="3"/></svg>
          <h3>Dans &amp; Cultuur</h3>
          <p>Ruimte voor podiumkunsten, muziek, exposities en stijldansen.</p>
        </article>
        <article class="item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 21c3 0 5-2 5-5l9-9a2.1 2.1 0 0 0-3-3l-9 9c-3 0-5 2-5 5"/><path d="M13 6l3 3"/></svg>
          <h3>Creativiteit &amp; Educatie</h3>
          <p>Cursussen zoals schilderen, naaien, een repair-café en computerles.</p>
        </article>
        <article class="item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11h18"/><path d="M5 11v2a7 7 0 0 0 14 0v-2"/><path d="M9 7c0-2 2-2 2-4M13 7c0-2 2-2 2-4"/></svg>
          <h3>Sociaal Welzijn</h3>
          <p>Laagdrempelige inloopuren, gezamenlijk koken en nieuwe spelclubs.</p>
        </article>
        <article class="item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="17" r="3.5"/><circle cx="18" cy="17" r="3.5"/><path d="M6 17l4-7h5l3 7"/><path d="M10 10l-1-3H7M15 10l1-4h2"/></svg>
          <h3>Generatiegericht</h3>
          <p>Vernieuwing van de jeugdsoos en ouderenopvang, en projecten zoals de duofiets.</p>
        </article>
        <article class="item">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-8-5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6-8 11-8 11z"/><path d="M12 10v5M9.5 12.5h5"/></svg>
          <h3>Zorg dichtbij</h3>
          <p>Onderzoek naar lokale spreekuren voor maatschappelijk werk, consultatiebureau en thuiszorg.</p>
        </article>
      </div>

      <p class="closing">Met dit veelzijdige aanbod blijft <strong>MFC de Skoalleseize</strong> een warme plek waar bewoners elkaar ontmoeten, ontplooien en ondersteunen.</p>
    </div>
  </section>

  <section id="verenigingen">
    <div class="wrap">
      <p class="eyebrow">Thuisbasis</p>
      <h2>Verenigingen in de Skoalleseize</h2>
      <ul class="clubs">
        <li><span class="tag">Voetbal</span><span class="name">SDS</span><a href="https://vv-sds.nl/" target="_blank" rel="noopener">vv-sds.nl</a></li>
        <li><span class="tag">Kaatsen</span><span class="name">KF Easterein</span><a href="https://kfeasterein.nl/" target="_blank" rel="noopener">kfeasterein.nl</a></li>
        <li><span class="tag">Muziek</span><span class="name">Fanfare Wilhelmina</span><a href="https://www.wilhelminaeasterein.nl/" target="_blank" rel="noopener">wilhelminaeasterein.nl</a></li>
        <li><span class="tag">Dammen</span><span class="name">Damclub</span><span class="none">Informatie via het MFC</span></li>
      </ul>
    </div>
  </section>

  <section id="gegevens">
    <div class="wrap">
      <p class="eyebrow">Gegevens</p>
      <h2>Contact en stichting</h2>
      <div class="cols">
        <div class="contact">
          <h3>Neem contact op</h3>
          <div class="row"><div><span class="k">Bezoekadres</span><span class="v">'t Heechhiem 11, 8734 GS Easterein</span></div></div>
          <div class="row"><div><span class="k">Telefoon</span><a class="v" href="tel:+31515333027">0515 333 027</a></div><button class="copy" type="button" data-copy="0515333027">Kopieer</button></div>
          <div class="row"><div><span class="k">E-mail</span><a class="v" href="mailto:mark.van.dorp@gmail.com">mark.van.dorp@gmail.com</a></div><button class="copy" type="button" data-copy="mark.van.dorp@gmail.com">Kopieer</button></div>
          <div class="row"><div><span class="k">Facebook</span><a class="v" href="https://www.facebook.com/Skoalleseize/?locale=nl_NL" target="_blank" rel="noopener">facebook.com/Skoalleseize</a></div></div>
        </div>
        <dl aria-label="Rechtspersoon">
          <dt>Statutaire naam</dt><dd>Stichting de Skoalleseize</dd>
          <dt>Rechtsvorm</dt><dd>Stichting</dd>
          <dt>RSIN</dt><dd>813589502</dd>
          <dt>Statutaire zetel</dt><dd>Gemeente Littenseradiel</dd>
          <dt>Bezoekadres</dt><dd>'t Heechhiem 11, 8734 GS Easterein</dd>
        </dl>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <span>© 2026 Stichting de Skoalleseize</span>
    <span>www.skoalleseize.nl · <a href="https://www.facebook.com/Skoalleseize/?locale=nl_NL" target="_blank" rel="noopener">Volg ons op Facebook</a></span>
  </div>
</footer>

<script>
document.querySelectorAll('button.copy').forEach(function(b){
  b.addEventListener('click',function(){
    var t=b.dataset.copy, done=function(){b.textContent='Gekopieerd';setTimeout(function(){b.textContent='Kopieer'},1600)};
    try{navigator.clipboard.writeText(t).then(done,function(){sel(b)})}catch(e){sel(b)}
  });
});
function sel(b){var v=b.parentNode.querySelector('.v');var r=document.createRange();r.selectNodeContents(v);var s=getSelection();s.removeAllRanges();s.addRange(r);}
</script>

</body>
</html>
